+/* Printing the team's entry passes (register success page + /passes). */
+.print-only {
+  display: none;
+}
+@media print {
+  body * {
+    visibility: hidden;
+  }
+  .print-area,
+  .print-area * {
+    visibility: visible;
+  }
+  .print-area {
+    position: absolute;
+    inset: 0 auto auto 0;
+    width: 100%;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    color: #000;
+  }
+  .print-only {
+    display: block;
+    grid-column: 1 / -1;
+  }
+  .no-print {
+    display: none !important;
+  }
+  .pass-card {
+    box-shadow: none !important;
+    border: 1px solid #ccc;
+    -webkit-print-color-adjust: exact;
+    print-color-adjust: exact;
+  }
+  @page {
+    margin: 12mm;
+  }
